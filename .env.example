# Gen Clover — enquiry endpoint configuration (api/lead.js)
#
# Copy to .env.local for local `vercel dev`, and set the real values in
# Vercel → Settings → Environment Variables for preview and production.
# Never commit real values. (Spec §17)
#
# Configure ONE delivery method. With neither set, /api/lead returns 503 and the
# form tells the visitor to email instead — it never silently drops a lead.

# --- Option A: email notification through Microsoft 365 (Microsoft Graph) ---
# App registration gc-website-mail in Microsoft Entra ID, with the
# application permission Mail.Send limited to the LEAD_NOTIFY_FROM mailbox.
MS_TENANT_ID=
MS_MAIL_CLIENT_ID=
MS_MAIL_CLIENT_SECRET=
# Internal notifications are sent from no-reply@. Anything sent to people
# outside the company should come from contact@genclover.com instead.
LEAD_NOTIFY_FROM=no-reply@genclover.com
# One address, or several separated by commas.
LEAD_NOTIFY_TO=contact@genclover.com
# Thank-you email to the person who submitted the brief. Sent from contact@
# (which must be in the app's access policy group); "off" disables it.
LEAD_CONFIRM_FROM=contact@genclover.com
# Copy of that thank-you, comma-separated; "none" for no copy.
LEAD_CONFIRM_CC=contact@genclover.com

# --- Option B: forward the lead record to a CRM / webhook ---
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# --- Careers: job posts and the admin portal (/admin) ---
# Postgres connection string. Added automatically when you connect a Neon
# database to the project (Vercel → Storage → Neon). Without it the careers
# page shows the seed roles in src/data/jobs.js and the admin portal is read-only.
DATABASE_URL=
# Admin sign-in. Run `npm run admin:hash-password` to generate the hash and the
# session secret. Never put the password itself here.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Optional: a Vercel Deploy Hook URL. Each job change triggers a rebuild so the
# sitemap and link previews include new roles (the role is live immediately anyway).
VERCEL_DEPLOY_HOOK_URL=

# Where job applications are emailed (default: LEAD_NOTIFY_TO, then contact@genclover.com).
# A role's own "Applications go to" address, set in /admin, takes precedence.
APPLY_NOTIFY_TO=

# --- Google Analytics 4 ---
# Measurement ID from GA4 → Admin → Data streams → your web stream (G-XXXXXXXXXX).
# Set it for Production (and Preview if you want preview traffic too). Without it,
# no analytics script loads at all. Built into the page, so redeploy after changing it.
VITE_GA_MEASUREMENT_ID=
